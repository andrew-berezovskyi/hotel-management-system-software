<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HotelMobileApp.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:HotelMobileApp.ViewModels"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White">

    <ContentPage.BindingContext>
        <viewModels:NotificationsViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">

        <!-- ===== HEADER ===== -->
        <Grid
            Grid.Row="0"
            Padding="16,20,16,12"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="White">

            <!-- Кнопка Назад (ImageButton з Command) -->
            <ImageButton
                WidthRequest="36"
                HeightRequest="36"
                Padding="0"
                BackgroundColor="#F3F3F3"
                CornerRadius="12"
                Source="icon_back_arrow.png"
                Command="{Binding GoBackCommand}"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Aspect="AspectFit" />

            <!-- Заголовок -->
            <Label
                Grid.Column="1"
                Text="Notification"
                FontSize="18"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <!-- ===== КОНТЕНТ ===== -->
        <Grid Grid.Row="1">

            <!-- Список повідомлень -->
            <CollectionView
                ItemsSource="{Binding Notifications}"
                IsVisible="{Binding HasNotifications}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid BackgroundColor="{Binding IsHighlighted, Converter={StaticResource BoolToColorConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Padding="16,12" ColumnDefinitions="Auto,*">
                                    <Image
                                        Source="{Binding IsSuccess, Converter={StaticResource NotificationIconConverter}}"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        VerticalOptions="Start"
                                        Margin="0,4,12,0" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label
                                            Text="{Binding Title}"
                                            FontAttributes="Bold"
                                            FontSize="14" />
                                        <Label
                                            Text="{Binding Message}"
                                            FontSize="12"
                                            TextColor="#555555" />
                                        <Label
                                            Text="{Binding TimeText}"
                                            FontSize="10"
                                            TextColor="#999999"
                                            Margin="0,4,0,0" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Порожній стан -->
            <Grid
                IsVisible="{Binding HasNoNotifications}"
                Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="1"
                    Text="Empty"
                    FontSize="22"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Margin="0,0,0,12" />

                <Image
                    Grid.Row="2"
                    Source="notifications_empty.png"
                    HeightRequest="160"
                    HorizontalOptions="Center"
                    Margin="0,0,0,12" />

                <Label
                    Grid.Row="3"
                    Text="You don't see any notifications here"
                    FontSize="12"
                    TextColor="#777777"
                    HorizontalOptions="Center"
                    Margin="0,8,0,0" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
