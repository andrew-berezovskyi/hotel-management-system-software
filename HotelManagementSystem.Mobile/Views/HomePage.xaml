<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HotelMobileApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:HotelMobileApp.ViewModels"
    x:Name="HomePageRoot"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F5F5">

    <ContentPage.BindingContext>
        <viewModels:HomeViewModel />
    </ContentPage.BindingContext>

    <!-- 0 - контент, 1 - закріплене нижнє меню -->
    <Grid RowDefinitions="*,Auto">

        <!-- ВСІЙ контент сторінки всередині ScrollView -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,16">

                <!-- HEADER з градієнтом, закругленням справа внизу -->
                <Border Margin="0" HeightRequest="260">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,40,0" />
                    </Border.StrokeShape>

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#141A2A" Offset="0.0" />
                            <GradientStop Color="#21598F" Offset="0.6" />
                            <GradientStop Color="#297BCF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Padding="20" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">

                        <!-- TOP BAR -->
                        <Grid
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="Auto,*,Auto"
                            VerticalOptions="Start">

                            <!-- Аватар -->
                            <Image
                                Source="avatar_user.png"
                                WidthRequest="32"
                                HeightRequest="32"
                                Aspect="AspectFill"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                                </Image.GestureRecognizers>
                            </Image>

                            <!-- Локація -->
                            <StackLayout
                                Grid.Column="1"
                                Spacing="2"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangeLocationCommand}" />
                                </StackLayout.GestureRecognizers>

                                <Label
                                    Text="Your location"
                                    TextColor="#FFFFFF88"
                                    FontSize="11"
                                    HorizontalOptions="Center" />

                                <StackLayout
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalOptions="Center">
                                    <Image
                                        Source="icon_location_white.png"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        VerticalOptions="Center" />
                                    <Label
                                        Text="{Binding CurrentLocation}"
                                        TextColor="White"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                </StackLayout>
                            </StackLayout>

                            <!-- Дзвоник -->
                            <Image
                                Grid.Column="2"
                                Source="icon_bell.png"
                                WidthRequest="24"
                                HeightRequest="24"
                                HorizontalOptions="End"
                                VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>

                        <!-- Текст + пошук -->
                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Spacing="16"
                            VerticalOptions="Center">

                            <Label
                                Text="Find Hotels, Villas,"
                                TextColor="White"
                                FontSize="22"
                                FontAttributes="Bold" />

                            <Label
                                Text="Lodging, that are around you!"
                                TextColor="White"
                                FontSize="16" />

                            <!-- Пошуковий блок -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52" Margin="0,8,0,0">

                                <!-- Темне поле -->
                                <Frame
                                    Grid.ColumnSpan="2"
                                    CornerRadius="14"
                                    Padding="16,0"
                                    BackgroundColor="#050816"
                                    Opacity="0.85"
                                    HasShadow="False"
                                    IsClippedToBounds="True">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Image
                                            Source="icon_search_field.png"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            VerticalOptions="Center"
                                            Margin="0,0,8,0" />
                                        <Entry
                                            Grid.Column="1"
                                            TextColor="White"
                                            Placeholder="Find the best Hotels"
                                            PlaceholderColor="#FFFFFF80"
                                            FontSize="14"
                                            BackgroundColor="Transparent" />
                                    </Grid>
                                </Frame>

                                <!-- Синя кнопка справа -->
                                <Frame
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    WidthRequest="52"
                                    HeightRequest="52"
                                    CornerRadius="18"
                                    Padding="0"
                                    HasShadow="False"
                                    IsClippedToBounds="True">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1E88E5" Offset="0.0" />
                                            <GradientStop Color="#0A63C7" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Image
                                        Source="icon_search_blue.png"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- AROUND YOU -->
                <Grid Margin="16,8,16,0">
                    <Grid RowDefinitions="Auto,Auto">

                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto"
                            Margin="0,0,0,8">
                            <Label
                                Text="Around you"
                                FontSize="18"
                                FontAttributes="Bold" />
                            <Label
                                Grid.Column="1"
                                Text="See more"
                                FontSize="13"
                                TextColor="#195BA9">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SeeMoreHotelsCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <CollectionView
                            Grid.Row="1"
                            ItemsSource="{Binding AroundYouHotels}"
                            ItemsLayout="HorizontalList"
                            SelectionMode="None"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,0,0,8">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="200" Margin="0,0,12,0">
                                        <Frame
                                            HasShadow="False"
                                            CornerRadius="18"
                                            Padding="0"
                                            BackgroundColor="White"
                                            IsClippedToBounds="True">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.OpenHotelDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Frame.GestureRecognizers>

                                            <Grid RowDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                                <Image
                                                    Grid.Row="0"
                                                    Source="{Binding Image}"
                                                    Aspect="AspectFill"
                                                    HeightRequest="120" />

                                                <Label
                                                    Grid.Row="1"
                                                    Text="{Binding Name}"
                                                    FontAttributes="Bold"
                                                    FontSize="14"
                                                    Margin="8,6,8,0" />

                                                <StackLayout
                                                    Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    Margin="8,0,8,8">
                                                    <Image
                                                        Source="icon_location_gray.png"
                                                        WidthRequest="12"
                                                        HeightRequest="12"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Text="{Binding City}"
                                                        FontSize="12"
                                                        TextColor="#777" />
                                                </StackLayout>
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>

                <!-- VIRTUAL TOUR -->
                <Grid Margin="16,8,16,0">
                    <Grid RowDefinitions="Auto,Auto">

                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto"
                            Margin="0,0,0,8">
                            <Label
                                Text="Virtual tour 360°"
                                FontSize="18"
                                FontAttributes="Bold" />
                            <Label
                                Grid.Column="1"
                                Text="See more"
                                FontSize="13"
                                TextColor="#195BA9">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SeeMoreToursCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <CollectionView
                            Grid.Row="1"
                            ItemsSource="{Binding VirtualTourHotels}"
                            ItemsLayout="HorizontalList"
                            SelectionMode="None"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,0,0,8">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="200" Margin="0,0,12,0">
                                        <Frame
                                            HasShadow="False"
                                            CornerRadius="18"
                                            Padding="0"
                                            BackgroundColor="White"
                                            IsClippedToBounds="True">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.OpenHotelDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Frame.GestureRecognizers>

                                            <Grid>
                                                <Image
                                                    Source="{Binding Image}"
                                                    Aspect="AspectFill"
                                                    HeightRequest="120" />
                                                <Frame
                                                    CornerRadius="12"
                                                    Padding="6,2"
                                                    BackgroundColor="#00000080"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Start"
                                                    Margin="8">
                                                    <Label
                                                        Text="360°"
                                                        TextColor="White"
                                                        FontSize="12"
                                                        FontAttributes="Bold" />
                                                </Frame>
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>

                <!-- PLACES YOU CAN VISIT -->
                <Grid Margin="16,8,16,0">
                    <Grid RowDefinitions="Auto,Auto">

                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto"
                            Margin="0,0,0,8">
                            <Label
                                Text="Places you can visit"
                                FontSize="18"
                                FontAttributes="Bold" />
                            <Label
                                Grid.Column="1"
                                Text="See more"
                                FontSize="13"
                                TextColor="#195BA9">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SeeMorePlacesCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <CollectionView
                            Grid.Row="1"
                            ItemsSource="{Binding PlacesYouCanVisit}"
                            ItemsLayout="HorizontalList"
                            SelectionMode="None"
                            HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="200" Margin="0,0,12,0">
                                        <Frame
                                            HasShadow="False"
                                            CornerRadius="18"
                                            Padding="0"
                                            BackgroundColor="White"
                                            IsClippedToBounds="True">
                                            <Grid RowDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                                <Image
                                                    Grid.Row="0"
                                                    Source="{Binding Image}"
                                                    Aspect="AspectFill"
                                                    HeightRequest="120" />
                                                <Label
                                                    Grid.Row="1"
                                                    Text="{Binding Name}"
                                                    FontAttributes="Bold"
                                                    FontSize="14"
                                                    Margin="8,6,8,0" />
                                                <Label
                                                    Grid.Row="2"
                                                    Text="{Binding City}"
                                                    FontSize="12"
                                                    TextColor="#777"
                                                    Margin="8,0,8,8" />
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ЗАКРІПЛЕНЕ НИЖНЄ МЕНЮ -->
        <Grid Grid.Row="1" Margin="16" VerticalOptions="End">
            <Frame CornerRadius="22" HasShadow="True" Padding="24,10">
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#151827" Offset="0.0" />
                        <GradientStop Color="#222C40" Offset="0.6" />
                        <GradientStop Color="#10121E" Offset="1.0" />
                    </LinearGradientBrush>
                </Frame.Background>

                <Grid ColumnDefinitions="*,*,*,*,*" VerticalOptions="Center">
                    <StackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                        <Image Source="icon_tab_home.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Home" FontSize="11" TextColor="White" HorizontalOptions="Center" />
                    </StackLayout>

                    <StackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Image Source="icon_tab_explore.png" WidthRequest="20" HeightRequest="20" />
                    </StackLayout>

                    <StackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Image Source="icon_tab_booking.png" WidthRequest="20" HeightRequest="20" />
                    </StackLayout>

                    <StackLayout Grid.Column="3" HorizontalOptions="Center">
                        <Image Source="icon_tab_wallet.png" WidthRequest="20" HeightRequest="20" />
                    </StackLayout>

                    <StackLayout Grid.Column="4" HorizontalOptions="Center">
                        <Image Source="icon_tab_profile.png" WidthRequest="20" HeightRequest="20" />
                    </StackLayout>
                </Grid>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
